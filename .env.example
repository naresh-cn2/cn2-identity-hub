# CN2.DEV — testimonials publishing (GitHub as the database)
#
# Copy the values you need into Vercel (Project Settings → Environment
# Variables) and to a local .env.local for development. Without REVIEWS_GH_TOKEN
# the review form still works: submissions are accepted and land in the
# server logs (Vercel dashboard → Functions logs) as private records;
# automatic public publishing activates the moment the token is set.

# Fine-grained personal access token:
#   GitHub → Settings → Developer settings → Fine-grained tokens →
#   Resource owner: naresh-cn2 → Repository access: only cn2-identity-hub →
#   Permissions: Contents (Read and Write). No other permission needed.
REVIEWS_GH_TOKEN=

# Optional. Defaults to naresh-cn2/cn2-identity-hub.
REVIEWS_REPO=naresh-cn2/cn2-identity-hub

# Optional. auto  = validated reviews with consent and a 4-5 star rating are
# published immediately (committed as published -> site rebuilds -> live).
# queue = committed with status "pending"; flip status to "published" in
# data/testimonials.json (via the GitHub web UI) to release them.
REVIEWS_PUBLISH_MODE=auto
