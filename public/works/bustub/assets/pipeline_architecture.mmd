    class SQL,Parser,Binder,BoundAST primary;
    class Planner,OptEngine,Rule1,Rule2,Rule3,OptPlan secondary;
    class ExecEngine,ExecContext,PlanRoot,PlanChild1,PlanChild2 accent;
    class TxnManager,LockManager,DeadlockDetector warn;
    class Catalog,TableHeap,BPlusTree,BPM,DiskScheduler,StorageDisk storage;
